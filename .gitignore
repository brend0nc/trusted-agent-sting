# Wiki is LLM-owned and host-local, per project convention (see wiki/SCHEMA.md, DECISIONS D12)
wiki/

# Run logs ARE committed (the shared artifact between pod and laptop; arms are sharded
# per-model so no single .eval approaches GitHub's 100MB file limit) — but not launcher stdout:
logs/launcher/

# Derived site data and the built site (regenerated by site/build.py)
site/data/
site/dist/

# Secrets
.env

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
build/
.pytest_cache/

# Local agent / tool state (worktrees, launch config, caches)
.claude/
.codex/
.superpowers/
.wrangler/
__marimo__/

# OS
.DS_Store

# Native runtime journals (complete compressed episode exports remain portable).
logs/**/run.sqlite3*
logs/**/run.lock
logs/**/status.json
.keys
scripts/comprehension_diagnostics.py
.gitignore
UtqedEcK.txt
.modal_passphrase
# Modal campaign raw downloads and reproducible bundle images (see artifacts/main-launch/*/COMMANDS.md)
artifacts/main-downloads/
artifacts/main-launch/**/bundle/image/
artifacts/main-analysis/**/prompted-detection/runs/

# Over GitHub 100 MB limit; kept local only
artifacts/labeling/2026-09-11/frozen-v6/tasks.json
